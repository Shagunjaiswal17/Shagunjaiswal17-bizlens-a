# ==============================================================================
# BizLens AI — Environment Configuration
# ==============================================================================

# Google Gemini API Settings (Supports Gemini 2.5 Flash)
# If omitted or quota exceeded, BizLens automatically falls back to offline demo mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Postgres-ready via SQLAlchemy)
DATABASE_URL=sqlite:///./bizlens.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bizlens_db

# Web3 / Polygon Amoy Testnet Settings (Chain ID: 80002)
CHAIN_ID=80002
WEB3_PROVIDER_URI=https://rpc-amoy.polygon.technology
AMOY_FALLBACK_RPC=https://polygon-amoy.drpc.org
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BACKEND_WALLET_PRIVATE_KEY=your_amoy_funder_private_key_optional

# Security & Session Authentication
JWT_SECRET=bizlens-ai-hackathon-super-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application Port
PORT=8000
